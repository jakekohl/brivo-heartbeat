BRIVO_CLIENT_ID=
BRIVO_CLIENT_SECRET=
BRIVO_API_KEY=
BRIVO_USERNAME=
BRIVO_PASSWORD=

# How often npm start asks Brivo. npm run check still runs once.
POLL_INTERVAL_MINUTES=5

# Separate from the poll interval. A panel that still says connected counts as down
# when lastContact is older than this.
LAST_CONTACT_MAX_MINUTES=30

# Used by npm start. npm run check does not send mail.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
ALERT_TO=
